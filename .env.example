# Copia este archivo a .env (cp .env.example .env) y llena JWT_CODE. Con eso el servidor
# arranca contra un MongoDB local. Producción no usa este archivo: sus valores viven en
# Render (ver DESPLIEGUE.md en el repo del frontend).

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=8080

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Requerido. String largo y aleatorio; nunca lo compartas ni lo subas al repo.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_CODE=

# ─── Base de datos ────────────────────────────────────────────────────────────
# Por defecto se usa un MongoDB local en DB_IP:DB_PORT, base SostekDB.
# Por ejemplo, con Docker:  docker run -d --name sostek-mongo -p 27017:27017 mongo:6
DB_IP=127.0.0.1
DB_PORT=27017

# MongoDB Atlas, que es la base de PRODUCCIÓN. Si defines DB_URL, se ignoran DB_IP y DB_PORT.
# Ojo: con el DB_URL de Atlas, todo lo que hagas en localhost escribe en la base real.
# Si mongodb+srv:// falla con "querySrv", usa el connection string estándar (mongodb://) que da Atlas.
# DB_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/SostekDB

# ─── Email (Nodemailer + Gmail) ───────────────────────────────────────────────
# Solo para probar la recuperación de contraseña. Si están vacías, el servidor avisa y sigue.
# EMAIL_PASS es una "contraseña de aplicación" de Google, no la contraseña normal:
# Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación.
EMAIL_USER=
EMAIL_PASS=

# URL del frontend: con ella se arma el link del correo de recuperación.
# En producción: https://sostek.vercel.app
FRONTEND_URL=http://localhost:3000

# Orígenes CORS extra, separados por coma. localhost:3000 y localhost:8100 ya están permitidos.
# En producción: https://sostek.vercel.app
CORS_ORIGIN=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Solo para subir fotos de perfil (POST /user/avatar) y para npm run seed:presentations.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
